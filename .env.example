# Copie este archivo a ".env" (que está excluido de git) y complete los
# valores reales antes de ejecutar el proyecto. Sin esto, manage.py no
# arranca: SECRET_KEY es obligatorio.

# Genere una clave larga y aleatoria, por ejemplo con:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=

# En desarrollo local puede dejarse en True; en producción debe ser False.
DEBUG=True

# Dominios/IPs permitidos, separados por coma. Obligatorio en producción
# (DEBUG=False) — Django rechaza todas las peticiones si queda vacío.
# Ejemplo: ALLOWED_HOSTS=midominio.com,www.midominio.com
ALLOWED_HOSTS=
